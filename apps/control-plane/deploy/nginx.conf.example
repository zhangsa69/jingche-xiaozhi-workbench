# Reverse proxy for the control plane. Terminates TLS and forwards to the
# loopback-bound service.
#
#   /etc/nginx/conf.d/control-plane.conf
#
# Keep CONTROL_PLANE_TRUST_PROXY=true so audit entries record real client IPs.

server {
    listen 80;
    server_name xiaozhi.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name xiaozhi.example.com;

    ssl_certificate     /etc/letsencrypt/live/xiaozhi.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/xiaozhi.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # The admin console ships bundled assets only; inline styles remain allowed
    # because the chart library positions SVG nodes with style attributes.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;

    client_max_body_size 2m;

    # Model traffic is a byte relay, often SSE. Buffering here would delay the
    # first token until the whole answer finished, so it stays off and the read
    # timeout covers a long generation.
    location /api/v1/gateway/ {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        gzip off;
    }

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 200s;
        proxy_send_timeout 200s;
    }

    # Health endpoints stay reachable for uptime checks without caching.
    location = /healthz {
        proxy_pass http://127.0.0.1:8787/healthz;
        access_log off;
    }

    location = /readyz {
        proxy_pass http://127.0.0.1:8787/readyz;
        access_log off;
    }
}
