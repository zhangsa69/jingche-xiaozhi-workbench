# Control plane environment. Install as /etc/control-plane/control-plane.env
# with mode 0600 and owner root:controlplane. Never commit real values.

# --- Required ---------------------------------------------------------------
# At least 32 characters. Signs access tokens and derives the AES key that
# encrypts stored gateway credentials. Rotating it invalidates sessions and
# makes existing gateway keys unreadable (re-enter them afterwards).
CONTROL_PLANE_SECRET=replace-with-64-random-hex-characters

# Public origin used in mail and client configuration.
CONTROL_PLANE_PUBLIC_URL=https://xiaozhi.example.com

# --- Networking -------------------------------------------------------------
# Keep loopback-only behind the reverse proxy.
CONTROL_PLANE_ADDR=127.0.0.1:8787
# Set to true only when a trusted reverse proxy terminates TLS and forwards
# X-Forwarded-For. Leaving it false behind a proxy records the proxy IP.
CONTROL_PLANE_TRUST_PROXY=true

# --- Storage ----------------------------------------------------------------
CONTROL_PLANE_DATA_DIR=/var/lib/control-plane
CONTROL_PLANE_WEB_DIR=/opt/control-plane/web
# CONTROL_PLANE_DB_PATH=/var/lib/control-plane/control-plane.db

# --- Accounts ---------------------------------------------------------------
# Comma-separated addresses promoted to administrator on registration.
CONTROL_PLANE_ADMIN_EMAILS=admin@company.com
CONTROL_PLANE_REGISTRATION_OPEN=true
CONTROL_PLANE_ACCESS_TTL_SECONDS=900
CONTROL_PLANE_REFRESH_TTL_DAYS=30
CONTROL_PLANE_CODE_TTL_SECONDS=600
CONTROL_PLANE_CODE_COOLDOWN_SECONDS=60
CONTROL_PLANE_CODE_MAX_PER_HOUR=5
CONTROL_PLANE_CODE_MAX_ATTEMPTS=5
CONTROL_PLANE_LOGIN_MAX_FAILURES=10

# --- SMTP (required in production) -----------------------------------------
# The authorization code lives only here. It is never stored in the database
# and never written to logs. Providers display it grouped ("abcd efgh ijkl
# mnop"); the spaces are stripped before use, so paste it either way.
#
# 163 / 126 (NetEase): smtp.163.com, 465, implicit, and FROM_EMAIL must be the
# same mailbox as USERNAME. Enable "SMTP服务" and set an "授权码" in the web
# mail settings first — the login password does not work here.
CONTROL_PLANE_SMTP_HOST=smtp.163.com
CONTROL_PLANE_SMTP_PORT=465
CONTROL_PLANE_SMTP_USERNAME=your-mailbox@163.com
CONTROL_PLANE_SMTP_PASSWORD=replace-with-netEase-authorization-code
CONTROL_PLANE_SMTP_FROM_EMAIL=your-mailbox@163.com
CONTROL_PLANE_SMTP_FROM_NAME=京车小智工作台
# starttls (587) | implicit (465) | insecure (local relay only)
CONTROL_PLANE_SMTP_TLS=implicit
# Self-check: ./control-plane --check-mail you@company.com
# Sends one real message and exits non-zero when the relay rejects it.

# --- Gateway ----------------------------------------------------------------
# Lifetime ceiling for the desktop gateway token; the login session expiry
# caps it further, and logout/disable/password reset revoke it immediately.
CONTROL_PLANE_GATEWAY_TOKEN_DAYS=30

# --- Logging ----------------------------------------------------------------
CONTROL_PLANE_LOG=info,tower_http=warn
